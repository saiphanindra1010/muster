{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muster",
  "version": "0.1.0",
  "identifier": "com.muster.app",
  "build": {
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Muster", "width": 1200, "height": 800 }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../opencode.jsonc": "opencode.jsonc",
      "../templates": "templates"
    },
    "externalBin": ["binaries/opencode"]
  }
}
