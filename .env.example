# Copy to .env and fill keys. Bun auto-loads this for the launcher + harness,
# so provider/websearch keys and MUSTER_* reach `opencode serve`.
# NOTE: VITE_* below do NOT reach `vite dev` from this file (vite reads .env
# from src/, not the repo root) - `run.sh` exports them explicitly instead.
# Providers - set what you use. Local (Ollama/LMStudio) needs no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# Websearch - set at least one; harness uses websearch.provider=random
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Google connectors (Gmail, Google Chat): needs a one-time Google Cloud OAuth
# client (Web application, "Use this client for an AI-powered agent", redirect
# URIs http://127.0.0.1:19876/callback and http://127.0.0.1:19877/callback).
# README section 6 walks through it. Restart the app after filling these in.
# GOOGLE_MCP_CLIENT_ID=
# GOOGLE_MCP_CLIENT_SECRET=

# Harness
# Data folder: defaults to the desktop app's folder, so browser mode and the
# desktop app share bots + chat history. Uncomment for an isolated sandbox:
# MUSTER_DATA_DIR=./data
MUSTER_PORT=4096
MUSTER_HOST=127.0.0.1
# 1 = keep all sessions (OpenCode prunes old data by default)
OPENCODE_DISABLE_PRUNE=1

# Web UI (reference only - exported by run.sh, not read from here)
# VITE_OPENCODE_URL=http://127.0.0.1:4096
# VITE_WORKSPACE_DIR=/path/to/muster/data/workspace
# VITE_OPENCODE_TOKEN=$(cat data/state/harness-token-4096)
